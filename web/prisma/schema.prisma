// Burger Oasis - PostgreSQL schema.
// Money is stored as integer pesewas (1 GHS = 100) to avoid floating point errors.
// Every sales channel (web, POS, phone) writes to the same Order table.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PLATFORM_OWNER
  RESTAURANT_OWNER
  GENERAL_MANAGER
  BRANCH_MANAGER
  CASHIER
  KITCHEN
  INVENTORY_MANAGER
  DELIVERY
  CUSTOMER
}

enum Channel {
  WEB
  POS
  PHONE
}

enum Fulfilment {
  DELIVERY
  COLLECTION
  DINE_IN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  MOBILE_MONEY
  CARD
  CASH
  BANK_TRANSFER
}

enum StockReason {
  PURCHASE
  SALE
  CANCELLATION_RESTORE
  WASTE
  ADJUSTMENT
  TRANSFER
  STOCKTAKE
}

enum PromoType {
  PERCENT
  FIXED
}

model Branch {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  address   String?
  phone     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  users       User[]
  orders      Order[]
  ingredients Ingredient[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  phone        String?
  passwordHash String
  role         Role     @default(CUSTOMER)
  branchId     String?
  branch       Branch?  @relation(fields: [branchId], references: [id])
  active       Boolean  @default(true)
  loyaltyPoints Int     @default(0)
  createdAt    DateTime @default(now())

  addresses  Address[]
  orders     Order[]   @relation("CustomerOrders")
  favourites Favourite[]
  auditLogs  AuditLog[]

  @@index([role])
}

model Address {
  id     String  @id @default(cuid())
  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  label  String?
  line1  String
  city   String
  notes  String?

  @@index([userId])
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  sortOrder Int       @default(0)
  products  Product[]
}

model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  imageUrl    String?
  basePrice   Int // pesewas
  promoPrice  Int? // pesewas, when on promotion
  available   Boolean  @default(true)
  featured    Boolean  @default(false)
  prepMinutes Int      @default(15)
  calories    Int?
  allergens   String[]
  ingredients String[]
  station     String? // kitchen station, e.g. GRILL, FRY, DRINKS
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sizes       ProductSize[]
  extras      ProductExtra[]
  recipe      RecipeLine[]
  orderItems  OrderItem[]
  favourites  Favourite[]

  @@index([categoryId, available])
}

model ProductSize {
  id         String  @id @default(cuid())
  productId  String
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name       String
  priceDelta Int // pesewas added to the base price

  @@unique([productId, name])
}

model ProductExtra {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  price     Int // pesewas
  available Boolean @default(true)

  @@unique([productId, name])
}

model Favourite {
  userId    String
  productId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
}

model PromoCode {
  id         String    @id @default(cuid())
  code       String    @unique
  type       PromoType
  value      Int // percent (1-100) or pesewas
  minSubtotal Int      @default(0)
  maxUses    Int?
  usedCount  Int       @default(0)
  startsAt   DateTime?
  endsAt     DateTime?
  active     Boolean   @default(true)
}

model Order {
  id            String        @id @default(cuid())
  reference     String        @unique // human readable, e.g. BO-240001
  idempotencyKey String?      @unique
  branchId      String
  branch        Branch        @relation(fields: [branchId], references: [id])
  channel       Channel       @default(WEB)
  customerId    String?
  customer      User?         @relation("CustomerOrders", fields: [customerId], references: [id])
  customerName  String
  customerPhone String
  customerEmail String?
  fulfilment    Fulfilment
  deliveryAddress String?
  deliveryNotes String?
  notes         String?
  promoCode     String?
  subtotal      Int
  discount      Int           @default(0)
  deliveryFee   Int           @default(0)
  total         Int
  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(UNPAID)
  cashierId     String?
  receiptNumber String?       @unique
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  items    OrderItem[]
  payments Payment[]
  events   OrderEvent[]

  @@index([status, createdAt])
  @@index([customerId])
  @@index([branchId, createdAt])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  name        String // snapshot at time of order
  sizeName    String?
  spice       String?
  extras      String[]
  quantity    Int
  unitPrice   Int // price per unit including size and extras, snapshot
  lineTotal   Int
  instructions String?
}

model Payment {
  id           String        @id @default(cuid())
  orderId      String
  order        Order         @relation(fields: [orderId], references: [id])
  method       PaymentMethod
  provider     String? // e.g. paystack
  providerRef  String?       @unique
  idempotencyKey String?     @unique
  amount       Int
  status       PaymentStatus @default(PENDING)
  verifiedAt   DateTime?
  failureReason String?
  createdAt    DateTime      @default(now())

  @@index([orderId])
}

// Append-only history of status changes and system events for an order.
model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      String // e.g. ORDER_CREATED, STATUS_CHANGED, PAYMENT_VERIFIED
  fromStatus OrderStatus?
  toStatus  OrderStatus?
  actorId   String?
  data      Json?
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

model Ingredient {
  id           String  @id @default(cuid())
  branchId     String
  branch       Branch  @relation(fields: [branchId], references: [id])
  name         String
  unit         String // g, ml, pcs
  quantity     Decimal @default(0)
  reorderLevel Decimal @default(0)
  unitCost     Int     @default(0) // pesewas per unit
  supplier     String?
  expiresAt    DateTime?

  recipeLines RecipeLine[]
  movements   StockMovement[]

  @@unique([branchId, name])
}

model RecipeLine {
  id           String     @id @default(cuid())
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  quantity     Decimal

  @@unique([productId, ingredientId])
}

model StockMovement {
  id           String      @id @default(cuid())
  ingredientId String
  ingredient   Ingredient  @relation(fields: [ingredientId], references: [id])
  delta        Decimal // positive adds stock, negative removes
  reason       StockReason
  orderId      String?
  note         String?
  actorId      String?
  createdAt    DateTime    @default(now())

  @@index([ingredientId, createdAt])
  @@index([orderId])
}

model Reservation {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String?
  guests    Int
  startsAt  DateTime
  tableNo   Int?
  notes     String?
  status    String   @default("CONFIRMED") // CONFIRMED | CANCELLED
  createdAt DateTime @default(now())

  @@index([startsAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  action    String
  entity    String
  entityId  String?
  data      Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

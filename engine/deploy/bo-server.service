[Unit]
Description=Burger Oasis sync server
After=network-online.target
Wants=network-online.target

[Service]
User=bo-server
Group=bo-server
ExecStart=/usr/local/bin/bo-server run /var/lib/bo-server
Restart=on-failure
RestartSec=5
# SIGTERM shuts down cleanly (stops accepting, lets open syncs finish).
KillSignal=SIGTERM
TimeoutStopSec=15

# Hardening: the service only needs its data directory and the network.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/var/lib/bo-server
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
UMask=0077

[Install]
WantedBy=multi-user.target
